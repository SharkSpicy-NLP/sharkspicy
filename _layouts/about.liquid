---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <div class="home-sections">
      <!-- News -->
      {% if page.announcements and page.announcements.enabled %}
        <section class="home-section">
          <h2 class="home-section-title">
            <a href="{{ '/news/' | relative_url }}" style="color: inherit">🔥 News</a>
          </h2>
          {% include news.liquid limit=true %}
        </section>
      {% endif %}

      <!-- Latest posts -->
      {% if page.latest_posts and page.latest_posts.enabled %}
        <section class="home-section">
          <h2 class="home-section-title">
            <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
          </h2>
          {% include latest_posts.liquid %}
        </section>
      {% endif %}

      <!-- Educations -->
      {% if page.educations %}
        <section class="home-section">
          <h2 class="home-section-title">🎓 Educations</h2>
          {% if site.data.educations and site.data.educations.size > 0 %}
            <ul class="home-timeline-list">
              {% for edu in site.data.educations %}
                <li>
                  <div class="home-timeline-heading">
                    {% if edu.period %}
                      <strong class="home-timeline-period">{{ edu.period }}</strong>
                      <span class="home-timeline-separator">|</span>
                    {% endif %}
                    {% if edu.logos and edu.logos.size > 0 %}
                      <span class="home-inline-icons" aria-label="Institutions">
                        {% for logo in edu.logos %}
                          {% assign logo_url = logo.url %}
                          {% if logo_url contains '://' %}
                            {% assign logo_src = logo_url %}
                          {% else %}
                            {% assign logo_src = logo_url | relative_url %}
                          {% endif %}
                          <img src="{{ logo_src }}" alt="{{ logo.alt }}" title="{{ logo.alt }}" width="22" height="22">
                        {% endfor %}
                      </span>
                    {% endif %}
                    <span class="home-timeline-copy"
                      ><strong>{{ edu.school }}</strong></span
                    >
                  </div>
                  <ul class="home-timeline-details">
                    <li>{{ edu.degree }}.</li>
                    {% if edu.details -%}
                      <li>{{ edu.details -}}</li>
                    {%- endif %}
                  </ul>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </section>
      {% endif %}

      <!-- Publications -->
      {% if page.selected_papers %}
        <section class="home-section">
          <h2 class="home-section-title">
            <a href="{{ '/publications/' | relative_url }}" style="color: inherit">📑 Publications</a>
          </h2>
          {% include selected_papers.liquid %}
        </section>
      {% endif %}

      <!-- Collaborative Publications -->
      {% if page.collaborative_papers %}
        <section class="home-section">
          <h2 class="home-section-title">🤝 Collaborative Publications</h2>
          {% include collaborative_papers.liquid %}
        </section>
      {% endif %}

      <!-- Internships -->
      {% if page.internships %}
        <section class="home-section">
          <h2 class="home-section-title">💼 Internships</h2>
          {% if site.data.internships and site.data.internships.size > 0 %}
            <ul class="home-timeline-list">
              {% for internship in site.data.internships %}
                {% assign internship_institution_keys = internship.institutions | default: '' | split: ',' %}
                <li>
                  <div class="home-timeline-heading">
                    {% if internship.period %}
                      <strong class="home-timeline-period">{{ internship.period }}</strong>
                      <span class="home-timeline-separator">|</span>
                    {% endif %}
                    <span
                      class="home-inline-icons{% unless internship.institutions %} home-inline-icons-empty{% endunless %}"
                      aria-label="Organizations"
                    >
                      {% for institution_key in internship_institution_keys %}
                        {% assign normalized_key = institution_key | strip %}
                        {% if normalized_key != '' %}
                          {% assign institution = site.data.institutions[normalized_key] %}
                          {% if institution %}
                            {% assign institution_logo = institution.logo %}
                            {% if institution_logo %}
                              {% if institution_logo contains '://' %}
                                {% assign institution_logo_src = institution_logo %}
                              {% else %}
                                {% assign institution_logo_src = institution_logo | relative_url %}
                              {% endif %}
                              <img
                                src="{{ institution_logo_src }}"
                                alt="{{ institution.name }}"
                                title="{{ institution.name }}"
                                width="22"
                                height="22"
                              >
                            {% else %}
                              <span class="home-inline-icon-mark" title="{{ institution.name }}">
                                {{- institution.short | default: normalized_key -}}
                              </span>
                            {% endif %}
                          {% else %}
                            <span class="home-inline-icon-mark" title="{{ normalized_key }}">{{ normalized_key | slice: 0, 2 }}</span>
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </span>
                    <span class="home-timeline-copy"
                      ><strong>{{ internship.organization }}</strong></span
                    >
                  </div>
                  {% if internship.details -%}
                    <ul class="home-timeline-details">
                      <li>{{ internship.details -}}</li>
                    </ul>
                  {%- endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </section>
      {% endif %}

      <!-- Academic Activities -->
      {% if page.academic_activities %}
        <section class="home-section">
          <h2 class="home-section-title">🎫 Academic Activities</h2>
          {% if site.data.academic_activities and site.data.academic_activities.size > 0 %}
            <ul class="academic-activities-list">
              {% for activity in site.data.academic_activities %}
                <li>
                  <strong>{{ activity.period }}</strong>, {{ activity.location }},
                  <strong>{{ activity.organization }}</strong>
                  {%- if activity.event -%}
                    , "{{ activity.event }}"
                  {%- endif -%}
                  {%- if activity.at %}
                    at {{ activity.at }}
                  {%- endif -%}
                  .
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </section>
      {% endif %}

      <!-- Honors and Awards -->
      {% if page.honors_awards %}
        <section class="home-section">
          <h2 class="home-section-title">🏆 Honors and Awards</h2>
          {% if site.data.honors_awards and site.data.honors_awards.size > 0 %}
            <ul>
              {% for award in site.data.honors_awards %}
                <li>
                  <strong>{{ award.title }}</strong>
                  {% if award.organization %}, {{ award.organization }}{% endif %}
                  {% if award.period %} ({{ award.period }}){% endif %}
                  {% if award.details -%}
                    <br>
                    {{ award.details -}}
                  {%- endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </section>
      {% endif %}
    </div>

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
